// 통합 Jenkinsfile
pipeline {
    agent any

    environment {
        // 기본값은 운영(prod) 환경으로 설정합니다. (안전장치)
        CREDENTIALS_ID = 'PROD_PROPERTIES'
        IMAGE_NAME = 'cocos-forest-app'
        CONTAINER_NAME = 'cocos-forest-app'
    }

    stages {
        // [새로운 단계] 브랜치에 따라 환경 변수를 설정하는 준비 단계
        stage('Prepare Environment') {
            steps {
                script {
                  if (env.gitlabTargetBranch == 'dev') {
                    echo "### Target branch is 'dev'. Setting DEV environment. ###"
                    env.CREDENTIALS_ID = 'DEV_PROPERTIES'
                    env.IMAGE_NAME = 'cocos-forest-app-dev'
                    env.CONTAINER_NAME = 'cocos-forest-app-dev'
                  } else {
                    echo "### Target branch is 'master'. Setting PROD environment. ###"
                    env.CREDENTIALS_ID = 'PROD_PROPERTIES'
                    env.IMAGE_NAME = 'cocos-forest-app'
                    env.CONTAINER_NAME = 'cocos-forest-app'
                  }
                }
            }
        }

        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    // 동적으로 설정된 이미지 이름을 사용합니다.
                    sh "docker build -t ${IMAGE_NAME} ."
                }
            }
        }

        stage('Deploy') {
            steps {
                // 동적으로 설정된 Credential ID를 사용합니다.
                withCredentials([file(credentialsId: "${CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        // 동적으로 설정된 컨테이너 이름을 사용
                        sh "docker stop ${CONTAINER_NAME} || true"
                        sh "docker rm ${CONTAINER_NAME} || true"

                        sh """
                        docker run -d --name ${CONTAINER_NAME} --network=cocos-network \\
                                   --env-file ${PROPERTIES_FILE_PATH} \\
                                   ${IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

     post {
       success {
         withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
           sh '''
             set -e
             TARGET="${gitlabTargetBranch:-${BRANCH_NAME}}"
             [ -z "$TARGET" ] && TARGET="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo dev)"

             # 커밋 7자리: git이 안 되면 환경변수로 대체
             COMMIT7="$(git rev-parse --short=7 HEAD 2>/dev/null || echo "$GIT_COMMIT" | cut -c1-7)"
             [ -z "$COMMIT7" ] && COMMIT7="unknown"

             # 작성자: GitLab 플러그인 변수 → Git → 환경변수 순
             AUTHOR="${gitlabUserName:-}"
             [ -z "$AUTHOR" ] && AUTHOR="$(git log -1 --pretty=format:%an 2>/dev/null || echo "${GIT_AUTHOR_NAME:-unknown}")"

             PAYLOAD=$(printf '%s' "{
               \"text\": \"\\n\\n\\`\\`\\`\\n항목\\t내용\\n🚀 Job\\t${JOB_NAME}\\n🔢 Build\\t#${BUILD_NUMBER}\\n🌿 Branch\\t${TARGET}\\ncommit\\t${COMMIT7}\\n🧑‍💻 Author\\t${AUTHOR}\\n📦 Docker Image\\t${IMAGE_NAME}\\n🔗 빌드 로그\\t${BUILD_URL}\\n\\`\\`\\`\"
             }")

             curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL"
           '''
         }
       }

       failure {
         withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
           sh '''
             set -e
             TARGET="${gitlabTargetBranch:-${BRANCH_NAME}}"
             [ -z "$TARGET" ] && TARGET="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo dev)"
             COMMIT7="$(git rev-parse --short=7 HEAD 2>/dev/null || echo "$GIT_COMMIT" | cut -c1-7)"
             [ -z "$COMMIT7" ] && COMMIT7="unknown"
             AUTHOR="${gitlabUserName:-}"
             [ -z "$AUTHOR" ] && AUTHOR="$(git log -1 --pretty=format:%an 2>/dev/null || echo "${GIT_AUTHOR_NAME:-unknown}")"

             PAYLOAD=$(printf '%s' "{
               \"text\": \":fire: **배포 실패!** :boom:\\n\\n\\`\\`\\`\\n항목\\t내용\\n🚀 Job\\t${JOB_NAME}\\n🔢 Build\\t#${BUILD_NUMBER}\\n🌿 Branch\\t${TARGET}\\ncommit\\t${COMMIT7}\\n🧑‍💻 Author\\t${AUTHOR}\\n🔗 에러 로그\\t${BUILD_URL}\\n\\`\\`\\`\"
             }")

             curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL"
           '''
         }
       }

       unstable {
         withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
           sh '''
             set -e
             TARGET="${gitlabTargetBranch:-${BRANCH_NAME}}"
             [ -z "$TARGET" ] && TARGET="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo dev)"
             COMMIT7="$(git rev-parse --short=7 HEAD 2>/dev/null || echo "$GIT_COMMIT" | cut -c1-7)"
             [ -z "$COMMIT7" ] && COMMIT7="unknown"
             AUTHOR="${gitlabUserName:-}"
             [ -z "$AUTHOR" ] && AUTHOR="$(git log -1 --pretty=format:%an 2>/dev/null || echo "${GIT_AUTHOR_NAME:-unknown}")"

             PAYLOAD=$(printf '%s' "{
               \"text\": \":warning: **빌드 불안정!**\\n\\n\\`\\`\\`\\n항목\\t내용\\n🚀 Job\\t${JOB_NAME}\\n🔢 Build\\t#${BUILD_NUMBER}\\n🌿 Branch\\t${TARGET}\\ncommit\\t${COMMIT7}\\n🧑‍💻 Author\\t${AUTHOR}\\n🔗 빌드 로그\\t${BUILD_URL}\\n\\`\\`\\`\"
             }")

             curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL"
           '''
         }
       }

       // 워크스페이스 정리는 '맨 마지막'에
       cleanup {
         cleanWs()
       }
     }

}