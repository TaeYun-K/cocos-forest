// 최종 수정된 Jenkinsfile
pipeline {
    agent any

    environment {
        // 기본값은 운영(prod) 환경으로 설정합니다.
        CREDENTIALS_ID = 'PROD_PROPERTIES'
        IMAGE_NAME = 'cocos-forest-app'
        CONTAINER_NAME = 'cocos-forest-app' // 일관성을 위해 '-prod'를 붙이는 것을 권장합니다.
    }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'dev') {
                        echo "### Target branch is 'dev'. Setting DEV environment. ###"
                        // [수정됨] 'env.' 접두사를 사용하여 파이프라인 전역 변수를 변경합니다.
                        env.CREDENTIALS_ID = 'DEV_PROPERTIES'
                        env.IMAGE_NAME = 'cocos-forest-app-dev'
                        env.CONTAINER_NAME = 'cocos-forest-app-dev'
                    } else {
                        echo "### Target branch is 'master'. Setting PROD environment. ###"
                    }
                }
            }
        }

        stage('Test & Build') { // [수정됨] 테스트를 포함하도록 단계 이름을 변경
            steps {
                // [수정됨] 테스트 실행을 위해 Credential을 사용하여 properties 파일을 복사합니다.
                withCredentials([file(credentialsId: "${env.CREDENTIALS_ID}", variable: 'APP_PROPERTIES')]) {
                    dir('cocos-forest') {
                        sh 'mkdir -p src/main/resources' // 테스트와 빌드 모두에 적용되도록 main 경로에 복사
                        sh "cp \\${APP_PROPERTIES} src/main/resources/application.properties"
                        sh 'chmod +x ./gradlew'
                        // [수정됨] '-x test' 옵션을 제거하여 테스트를 포함한 전체 빌드를 수행합니다.
                        sh './gradlew clean build'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    sh "docker build -t ${env.IMAGE_NAME} ."
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: "${env.CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        sh "docker stop ${env.CONTAINER_NAME} || true"
                        sh "docker rm ${env.CONTAINER_NAME} || true"

                        sh """
                        docker run -d --name ${env.CONTAINER_NAME} --network=cocos-network \\
                                   --env-file ${PROPERTIES_FILE_PATH} \\
                                   ${env.IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}