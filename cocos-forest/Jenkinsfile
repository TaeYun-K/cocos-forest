pipeline {
    agent any

    environment {
        // 기본값은 운영(prod)용으로 설정합니다.
        CREDENTIALS_ID = 'PROD_PROPERTIES'
        IMAGE_NAME = 'cocos-forest-app'
        CONTAINER_NAME = 'cocos-forest-app'
    }

    stages {

        // 브랜치에 따라 변수 값을 설정하는 준비 단계
        stage('Prepare Environment') {
            steps {
                script {
                    // 현재 브랜치가 develop이면, 변수들을 dev용 값으로 덮어씁니다.
                    if (env.BRANCH_NAME == 'dev') {
                        echo "Running on 'dev' branch. Setting DEV environment."
                        CREDENTIALS_ID = 'DEV_PROPERTIES'
                        IMAGE_NAME = 'cocos-forest-app-dev'
                        CONTAINER_NAME = 'cocos-forest-app-dev'
                    } else {
                        echo "Running on 'master' branch. Setting PROD environment."
                    }
                }
            }
        }

        // [수정됨] Build 스테이지를 단순화합니다.
        stage('Build') {
            steps {
                // GitLab에서 받은 프로젝트 폴더(cocos-forest)로 이동합니다.
                dir('cocos-forest') {
                    // Gradle 실행 권한을 부여합니다.
                    sh 'chmod +x ./gradlew'
                    // DB 연결이 필요한 테스트는 건너뛰고(-x test) 빌드를 수행합니다.
                    sh './gradlew clean build -x test'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    // 프로젝트 루트의 Dockerfile을 사용하여 Docker 이미지를 빌드합니다.
                    sh 'docker build -t ${IMAGE_NAME} .'
                }
            }
        }
        // [수정 완료된 부분] Deploy 스테이지는 그대로 둡니다.
        stage('Deploy') {
            steps {
                // 동적으로 결정된 Credential ID(${CREDENTIALS_ID})를 사용합니다.
                withCredentials([file(credentialsId: "${CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {

                        // 기존 컨테이너 중지 및 삭제
                        // 동적으로 결정된 컨테이너 이름(${CONTAINER_NAME})을 사용합니다.
                        sh "docker stop ${CONTAINER_NAME} || true"
                        sh "docker rm ${CONTAINER_NAME} || true"

                        // 환경 변수를 주입하여 컨테이너 실행
                        sh """
                        docker run -d --name ${CONTAINER_NAME} --network=cocos-network \
                                   --env-file ${PROPERTIES_FILE_PATH} \
                                   ${IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }
    // 파이프라인이 끝나면 항상 작업 공간을 정리하여 서버 용량을 확보합니다.
    post {
        always {
            cleanWs()
        }
    }
}