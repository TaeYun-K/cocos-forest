// 통합 Jenkinsfile
pipeline {
    agent any

    environment {
        // 기본값은 운영(prod) 환경으로 설정합니다. (안전장치)
        CREDENTIALS_ID = 'PROD_PROPERTIES'
        IMAGE_NAME = 'cocos-forest-app'
        CONTAINER_NAME = 'cocos-forest-app'
    }

    stages {
        // [새로운 단계] 브랜치에 따라 환경 변수를 설정하는 준비 단계
        stage('Prepare Environment') {
            steps {
                script {
                    // GitLab Merge Request의 'Target Branch'를 기준으로 분기합니다.
                    // 이 변수가 더 정확하고 신뢰성 높습니다.
                    if (env.gitlabTargetBranch == 'dev') {
                        echo "### Target branch is 'dev'. Setting DEV environment. ###"
                        CREDENTIALS_ID = 'DEV_PROPERTIES'
                        IMAGE_NAME = 'cocos-forest-app-dev'
                        CONTAINER_NAME = 'cocos-forest-app-dev'
                    } else {
                        echo "### Target branch is 'master'. Setting PROD environment. ###"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    // 동적으로 설정된 이미지 이름을 사용합니다.
                    sh "docker build -t ${IMAGE_NAME} ."
                }
            }
        }

        stage('Deploy') {
            steps {
                // 동적으로 설정된 Credential ID를 사용합니다.
                withCredentials([file(credentialsId: "${CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        // 동적으로 설정된 컨테이너 이름을 사용
                        sh "docker stop ${CONTAINER_NAME} || true"
                        sh "docker rm ${CONTAINER_NAME} || true"

                        sh """
                        docker run -d --name ${CONTAINER_NAME} --network=cocos-network \\
                                   --env-file ${PROPERTIES_FILE_PATH} \\
                                   ${IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

    post {
      success {
          withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
            sh '''#!/usr/bin/env sh
              set -eu

              # --- 변수 설정 ---
              COMMIT_HASH=$(printf "%s" "${GIT_COMMIT}" | cut -c1-7)
              TARGET_BRANCH="${gitlabTargetBranch}"
              AUTHOR_NAME="${gitlabUserName:-Git}" # GitLab 플러그인 변수, 없을 경우 'Git'

              # --- 환경별 메시지 및 색상 설정 ---
              if [ "$TARGET_BRANCH" = "dev" ]; then
                  TITLE_MSG="🌱 **코코야** 개발 서버 배포 성공!"
                  # [수정됨] 백슬래시 이스케이프 처리: \` -> \\`
                  MAIN_MSG="✅ \\`dev\\` 브랜치가 개발 서버에 성공적으로 배포되었습니다."
                  ATTACHMENT_COLOR="#007bff" # 파란색
              else
                  TITLE_MSG="🎉 **코코야** 운영 서버 배포 성공!"
                  # [수정됨] 백슬래시 이스케이프 처리: \` -> \\`
                  MAIN_MSG="✅ \\`master\\` 브랜치가 운영 서버에 성공적으로 배포되었습니다."
                  ATTACHMENT_COLOR="#28a745" # 초록색
              fi

              # --- Mattermost Payload 생성 ---
              JSON_PAYLOAD=$(printf '{
                  "channel": "@channel",
                  "text": "## %s\\n---",
                  "attachments": [
                      {
                          "color": "%s",
                          "text": "**%s**",
                          "fields": [
                              { "short": true, "title": "🚀 Job", "value": "%s" },
                              { "short": true, "title": "🔢 Build", "value": "#%s" },
                              { "short": true, "title": "🌿 Branch", "value": "`%s`" },
                              { "short": true, "title": "commit", "value": "`%s`" },
                              { "short": true, "title": "🧑‍💻 Author", "value": "%s" },
                              { "short": true, "title": "📦 Docker Image", "value": "`%s`" }
                          ],
                          "actions": [
                              {
                                 "name": "빌드 로그 확인하기",
                                 "integration": {
                                     "url": "%s",
                                     "context": { "action": "open_url" }
                                 }
                              }
                          ]
                      }
                  ]
              }' "$TITLE_MSG" "$ATTACHMENT_COLOR" "$MAIN_MSG" "${JOB_NAME}" "${BUILD_NUMBER}" "$TARGET_BRANCH" "$COMMIT_HASH" "$AUTHOR_NAME" "${IMAGE_NAME}" "${BUILD_URL}")

              # --- curl 요청 ---
              curl -sS -X POST -H 'Content-Type: application/json' -d "$JSON_PAYLOAD" "$MM_URL"
            '''
          }
      }

      failure {
        withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
          sh '''#!/usr/bin/env sh
            set -eu
            COMMIT7=$(printf "%s" "${GIT_COMMIT}" | cut -c1-7)
            TARGET="${gitlabTargetBranch}"

            JSON=$(printf '{"text":":fire: **배포 실패!** :boom:\\n- **Job**: %s\\n- **Build**: #%s\\n- **Branch**: %s\\n🔗 [에러 로그 확인](%s)\\n@here"}' \
                  "${JOB_NAME}" "${BUILD_NUMBER}" "${TARGET}" "${BUILD_URL}")

            curl -sS -X POST -H 'Content-Type: application/json' -d "$JSON" "$MM_URL"
          '''
        }
      }

      unstable {
        withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
          sh '''#!/usr/bin/env sh
            set -eu
            JSON=$(printf '{"text":":warning: **빌드 불안정!**\\n- **Job**: %s\\n- **Build**: #%s\\n🔗 [자세히 보기](%s)"}' \
                  "${JOB_NAME}" "${BUILD_NUMBER}" "${BUILD_URL}")

            curl -sS -X POST -H 'Content-Type: application/json' -d "$JSON" "$MM_URL"
          '''
        }
      }

      always { cleanWs() }
    }

}