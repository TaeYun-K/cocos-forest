pipeline {
    agent any

    // 파이프라인 전체에서 사용할 수 있도록 맨 위에 Credentials를 선언합니다.
    // Jenkins는 APP_PROPERTIES라는 변수에 Secret 파일의 임시 경로를 담아줍니다.
    environment {
        APP_PROPERTIES = credentials('PROD_PROPERTIES')
    }

    stages {
        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    // Gradle 빌드를 실행할 때, -Dspring.config.location 옵션으로
                    // Jenkins 금고에서 꺼내온 '진짜' 설정 파일의 위치를 직접 알려줍니다.
                    sh "./gradlew clean build -Dspring.config.location=file://${env.APP_PROPERTIES}"
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    sh 'docker build -t cocos-forest-app .'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker stop cocos-forest-app || true'
                sh 'docker rm cocos-forest-app || true'

                // Deploy 시점에도 똑같은 '진짜' 설정 파일을 컨테이너에 주입합니다.
                sh "docker run -d --name cocos-forest-app --network=cocos-network -v ${env.APP_PROPERTIES}:/config/application.properties cocos-forest-app"
            }
        }
    }
}