pipeline {
    agent any

    stages {
        // [수정됨] Build 스테이지를 단순화합니다.
        stage('Build') {
            steps {
                // GitLab에서 받은 프로젝트 폴더(cocos-forest)로 이동합니다.
                dir('cocos-forest') {
                    // Gradle 실행 권한을 부여합니다.
                    sh 'chmod +x ./gradlew'
                    // DB 연결이 필요한 테스트는 건너뛰고(-x test) 빌드를 수행합니다.
                    sh './gradlew clean build -x test'
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    // 프로젝트 루트의 Dockerfile을 사용하여 Docker 이미지를 빌드합니다.
                    sh 'docker build -t cocos-forest-app .'
                }
            }
        }
        // [수정 완료된 부분] Deploy 스테이지는 그대로 둡니다.
        stage('Deploy') {
            steps {
                // withCredentials 블록으로 PROD_PROPERTIES 파일의 임시 '경로'를 가져옵니다.
                withCredentials([file(credentialsId: 'PROD_PROPERTIES', variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        // 이제 PROPERTIES_FILE_PATH 변수에 담긴 '파일 경로'를 사용해 내용을 읽습니다.
                        def props = readProperties file: "${PROPERTIES_FILE_PATH}"
                        def dbUrl = props['spring.datasource.url']
                        def dbUsername = props['spring.datasource.username']
                        def dbPassword = props['spring.datasource.password']

                        // 기존 컨테이너 중지 및 삭제
                        sh 'docker stop cocos-forest-app || true'
                        sh 'docker rm cocos-forest-app || true'

                        // 환경 변수를 주입하여 컨테이너 실행
                        sh """
                        docker run -d --name cocos-forest-app --network=cocos-network \
                                   -e SPRING_DATASOURCE_URL='${dbUrl}' \
                                   -e SPRING_DATASOURCE_USERNAME='${dbUsername}' \
                                   -e SPRING_DATASOURCE_PASSWORD='${dbPassword}' \
                                   cocos-forest-app
                        """
                    }
                }
            }
        }
    }
    // 파이프라인이 끝나면 항상 작업 공간을 정리하여 서버 용량을 확보합니다.
    post {
        always {
            cleanWs()
        }
    }
}