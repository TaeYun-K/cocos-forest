pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                withCredentials([file(credentialsId: 'PROD_PROPERTIES', variable: 'APP_PROPERTIES')]) {
                    dir('cocos-forest') {
                        sh 'mkdir -p src/test/resources'
                        sh "cp ${APP_PROPERTIES} src/test/resources/application.properties"
                        sh 'chmod +x ./gradlew'
                        sh './gradlew clean build'
                    }
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    sh 'docker build -t cocos-forest-app .'
                }
            }
        }
        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: 'PROD_PROPERTIES', variable: 'APP_PROPERTIES')]) {
                    sh 'docker stop cocos-forest-app || true'
                    sh 'docker rm cocos-forest-app || true'
                    sh "docker run -d --name cocos-forest-app --network=cocos-network -v ${APP_PROPERTIES}:/config/application.properties cocos-forest-app"
                }
            }
        }
    }
    post {
        success {
            cleanWs()
        }
    }
}