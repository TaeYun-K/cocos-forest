// develop/master 파이프라인 분리 환경에 최적화된 Jenkinsfile
pipeline {
    agent any

    environment {
        CREDENTIALS_ID = ''
        IMAGE_NAME     = ''
        CONTAINER_NAME = ''
    }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    def PROD_CONFIG = [
                        CREDENTIALS_ID: 'PROD_PROPERTIES',
                        IMAGE_NAME    : 'cocos-forest-app',
                        CONTAINER_NAME: 'cocos-forest-app'
                    ]
                    def DEV_CONFIG = [
                        CREDENTIALS_ID: 'DEV_PROPERTIES',
                        IMAGE_NAME    : 'cocos-forest-app-dev',
                        CONTAINER_NAME: 'cocos-forest-app-dev'
                    ]

                    def config // 이번 빌드에서 사용할 설정을 담을 변수

                    // [핵심] 현재 빌드 중인 브랜치 이름(env.BRANCH_NAME)을 기준으로 환경을 결정합니다.
                    // 이 방식은 자동/수동 실행 여부와 관계없이 항상 정확하게 동작합니다.
                    if (env.BRANCH_NAME == 'dev') {
                        echo "### Branch is 'dev'. Setting DEV environment. ###"
                        config = DEV_CONFIG
                    } else { // 'master' 브랜치 또는 예상치 못한 다른 브랜치는 모두 PROD로 처리 (안전장치)
                        echo "### Branch is '${env.BRANCH_NAME}'. Setting PROD environment. ###"
                        config = PROD_CONFIG
                    }

                    // 선택된 설정을 실제 파이프라인 변수에 할당합니다.
                    CREDENTIALS_ID = config.CREDENTIALS_ID
                    IMAGE_NAME     = config.IMAGE_NAME
                    CONTAINER_NAME = config.CONTAINER_NAME

                    echo "### Environment Set ###"
                    echo "IMAGE_NAME: ${IMAGE_NAME}"
                    echo "CONTAINER_NAME: ${CONTAINER_NAME}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    sh "docker build -t ${IMAGE_NAME} ."
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: "${CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        sh "docker stop ${CONTAINER_NAME} || true"
                        sh "docker rm ${CONTAINER_NAME} || true"

                        sh """
                        docker run -d --name ${CONTAINER_NAME} --network=cocos-network \\
                                   --env-file ${PROPERTIES_FILE_PATH} \\
                                   ${IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}