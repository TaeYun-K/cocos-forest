// 통합 Jenkinsfile
pipeline {
    agent any

    environment {
        // 기본값은 운영(prod) 환경으로 설정합니다. (안전장치)
        CREDENTIALS_ID = 'PROD_PROPERTIES'
        IMAGE_NAME = 'cocos-forest-app'
        CONTAINER_NAME = 'cocos-forest-app'
    }

    stages {
        // [새로운 단계] 브랜치에 따라 환경 변수를 설정하는 준비 단계
        stage('Prepare Environment') {
            steps {
                script {
                    // GitLab Merge Request의 'Target Branch'를 기준으로 분기합니다.
                    // 이 변수가 더 정확하고 신뢰성 높습니다.
                    if (env.gitlabTargetBranch == 'dev') {
                        echo "### Target branch is 'dev'. Setting DEV environment. ###"
                        CREDENTIALS_ID = 'DEV_PROPERTIES'
                        IMAGE_NAME = 'cocos-forest-app-dev'
                        CONTAINER_NAME = 'cocos-forest-app-dev'
                    } else {
                        echo "### Target branch is 'master'. Setting PROD environment. ###"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    // 동적으로 설정된 이미지 이름을 사용합니다.
                    sh "docker build -t ${IMAGE_NAME} ."
                }
            }
        }

        stage('Deploy') {
            steps {
                // 동적으로 설정된 Credential ID를 사용합니다.
                withCredentials([file(credentialsId: "${CREDENTIALS_ID}", variable: 'PROPERTIES_FILE_PATH')]) {
                    script {
                        // 동적으로 설정된 컨테이너 이름을 사용
                        sh "docker stop ${CONTAINER_NAME} || true"
                        sh "docker rm ${CONTAINER_NAME} || true"

                        sh """
                        docker run -d --name ${CONTAINER_NAME} --network=cocos-network \\
                                   --env-file ${PROPERTIES_FILE_PATH} \\
                                   ${IMAGE_NAME}
                        """
                    }
                }
            }
        }
    }

    post {
      success {
        withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
          sh '''
            set -e
            TARGET="${TARGET_BRANCH}"
            COMMIT7=$(git rev-parse --short=7 HEAD 2>/dev/null || echo "${GIT_COMMIT}" | cut -c1-7)
            AUTHOR=$(git --no-pager log -1 --pretty=format:%an 2>/dev/null || echo "unknown")

            read -r -d '' PAYLOAD <<'JSON'
    {
      "text": ":rocket: **배포 성공!** :tada:\\n"
              "항목\\t내용\\n"
              "🚀 Job\\t${JOB_NAME}\\n"
              "🔢 Build\\t#${BUILD_NUMBER}\\n"
              "🌿 Branch\\t${TARGET}\\n"
              "commit\\t${COMMIT7}\\n"
              "🧑‍💻 Author\\t${AUTHOR}\\n"
              "📦 Docker Image\\t${IMAGE_NAME}\\n"
              "🔗 빌드 로그\\t${BUILD_URL}"
    }
    JSON

            # 변수 치환
            PAYLOAD=$(echo "$PAYLOAD" \
              | sed "s|\${JOB_NAME}|${JOB_NAME}|g" \
              | sed "s|\${BUILD_NUMBER}|${BUILD_NUMBER}|g" \
              | sed "s|\${TARGET}|${TARGET}|g" \
              | sed "s|\${COMMIT7}|${COMMIT7}|g" \
              | sed "s|\${AUTHOR}|${AUTHOR}|g" \
              | sed "s|\${IMAGE_NAME}|${IMAGE_NAME}|g" \
              | sed "s|\${BUILD_URL}|${BUILD_URL}|g" )

            curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL" >/dev/null
          '''
        }
      }

      failure {
        withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
          sh '''
            set -e
            TARGET="${TARGET_BRANCH}"
            COMMIT7=$(git rev-parse --short=7 HEAD 2>/dev/null || echo "${GIT_COMMIT}" | cut -c1-7)
            AUTHOR=$(git --no-pager log -1 --pretty=format:%an 2>/dev/null || echo "unknown")

            read -r -d '' PAYLOAD <<'JSON'
    {
      "text": ":fire: **배포 실패!** :boom:\\n"
              "항목\\t내용\\n"
              "🚀 Job\\t${JOB_NAME}\\n"
              "🔢 Build\\t#${BUILD_NUMBER}\\n"
              "🌿 Branch\\t${TARGET}\\n"
              "commit\\t${COMMIT7}\\n"
              "🧑‍💻 Author\\t${AUTHOR}\\n"
              "📦 Docker Image\\t${IMAGE_NAME}\\n"
              "🔗 에러 로그\\t${BUILD_URL}\\n"
              "@here"
    }
    JSON

            PAYLOAD=$(echo "$PAYLOAD" \
              | sed "s|\${JOB_NAME}|${JOB_NAME}|g" \
              | sed "s|\${BUILD_NUMBER}|${BUILD_NUMBER}|g" \
              | sed "s|\${TARGET}|${TARGET}|g" \
              | sed "s|\${COMMIT7}|${COMMIT7}|g" \
              | sed "s|\${AUTHOR}|${AUTHOR}|g" \
              | sed "s|\${IMAGE_NAME}|${IMAGE_NAME}|g" \
              | sed "s|\${BUILD_URL}|${BUILD_URL}|g" )

            curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL" >/dev/null
          '''
        }
      }

      unstable {
        withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_URL')]) {
          sh '''
            set -e
            TARGET="${TARGET_BRANCH}"
            COMMIT7=$(git rev-parse --short=7 HEAD 2>/dev/null || echo "${GIT_COMMIT}" | cut -c1-7)
            AUTHOR=$(git --no-pager log -1 --pretty=format:%an 2>/dev/null || echo "unknown")

            read -r -d '' PAYLOAD <<'JSON'
    {
      "text": ":warning: **빌드 불안정!**\\n"
              "항목\\t내용\\n"
              "🚀 Job\\t${JOB_NAME}\\n"
              "🔢 Build\\t#${BUILD_NUMBER}\\n"
              "🌿 Branch\\t${TARGET}\\n"
              "commit\\t${COMMIT7}\\n"
              "🧑‍💻 Author\\t${AUTHOR}\\n"
              "📦 Docker Image\\t${IMAGE_NAME}\\n"
              "🔗 자세히 보기\\t${BUILD_URL}"
    }
    JSON

            PAYLOAD=$(echo "$PAYLOAD" \
              | sed "s|\${JOB_NAME}|${JOB_NAME}|g" \
              | sed "s|\${BUILD_NUMBER}|${BUILD_NUMBER}|g" \
              | sed "s|\${TARGET}|${TARGET}|g" \
              | sed "s|\${COMMIT7}|${COMMIT7}|g" \
              | sed "s|\${AUTHOR}|${AUTHOR}|g" \
              | sed "s|\${IMAGE_NAME}|${IMAGE_NAME}|g" \
              | sed "s|\${BUILD_URL}|${BUILD_URL}|g" )

            curl -sS -X POST -H 'Content-Type: application/json' -d "$PAYLOAD" "$MM_URL" >/dev/null
          '''
        }
      }

      always {
        cleanWs()
      }
    }

}