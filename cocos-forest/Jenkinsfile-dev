pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('cocos-forest') {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('cocos-forest') {
                    sh 'docker build -t cocos-forest-app-dev .'
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: 'DEV_PROPERTIES', variable: 'PROPERTIES_FILE_PATH')]) {
                    sh 'docker stop cocos-forest-app-dev || true'
                    sh 'docker rm cocos-forest-app-dev || true'
                    sh """
                    docker run -d --name cocos-forest-app-dev --network=cocos-network \
                               --env-file ${PROPERTIES_FILE_PATH} \
                               cocos-forest-app-dev
                    """
                }
            }
        }
        // test
    }

    post {
        always {
            cleanWs()
        }
    }
}