# 백엔드 API 설정
EXPO_PUBLIC_API_BASE_URL_DEV=https://j13e205.p.ssafy.io/dev
EXPO_PUBLIC_API_BASE_URL_PROD=https://j13e205.p.ssafy.io/dev

# API 타임아웃 설정 (밀리초)
EXPO_PUBLIC_API_TIMEOUT=10000

# 앱 환경 설정
EXPO_PUBLIC_APP_NAME=CocoForest
